# Salin ke .env lalu isi nilainya. JANGAN commit file .env!

# Neon — pooled connection (runtime / Vercel). Host mengandung "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon — direct connection (prisma migrate). Host TANPA "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Akun superadmin awal (dipakai `npm run db:seed`)
SEED_SUPERADMIN_USERNAME="superadmin"
SEED_SUPERADMIN_PASSWORD=""
